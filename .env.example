# Local development environment for awesome-agent-trust maintenance.
# Copy this file to .env (or export the variables directly) when running
# the maintenance scripts in .github/scripts/ locally.
#
# Tokens are only used to raise the GitHub API rate limit
# (60 requests/hour unauthenticated vs 5,000 requests/hour authenticated).
# List submissions never require a token.

# Personal access token with public read access.
# Create one at https://github.com/settings/tokens (no scopes needed for
# public repository metadata; the `repo` scope is NOT required).
GH_TOKEN=

# GITHUB_TOKEN is also honored (CI sets it automatically; it takes
# precedence only when GH_TOKEN is unset).
GITHUB_TOKEN=